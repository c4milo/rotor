.{
    .name = .rotor,
    .version = "0.2.0",
    .fingerprint = 0x29e3041344319961, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Developer tooling only, never linked into the library. Lazy, and requested only when
        // rotor is the root build, so a project that depends on rotor never fetches it.
        .pepegrillo = .{
            .url = "git+https://github.com/c4milo/pepegrillo#08f7f0101adb2b5f0389a6927a899316bbc44c46",
            .hash = "pepegrillo-0.0.0-axiFUEutBwDoP8_Z69Bb9N-jrIXRuAPsCnCUDHPW7hg6",
            .lazy = true,
        },
        // The two alternatives below are what the harness measures rotor against, pinned so that
        // a comparison names the exact source it ran (CLAUDE.md, Milestones 2 and 4). The owner's
        // brief requires both, so they are sanctioned dependencies. They are bench-only and never
        // linked into the library. Both are lazy, and build/alternatives.zig requests them only
        // under `zig build bench-alternatives`, so neither `zig build test` nor a project that
        // depends on rotor fetches them. bench/alternatives/README.md holds the pins.
        //
        // libuv v1.52.1, the stable release of 2026-03-06: the tag names commit
        // 1cfa32ff59c076ffb6ed735bbc8c18361558661f. It ships no build.zig, so
        // build/alternatives.zig compiles its C sources.
        .libuv = .{
            .url = "https://github.com/libuv/libuv/archive/refs/tags/v1.52.1.tar.gz",
            .hash = "N-V-__8AACwTRQDmmfDj0GPrcObUmVnktArTdpjkEvRZXTx0",
            .lazy = true,
        },
        // libxev at the head of its main branch on 2026-09-19, which builds with Zig 0.16.0. It
        // has no release tag, so the pin is the commit.
        .libxev = .{
            .url = "https://github.com/mitchellh/libxev/archive/9ce8e8e6ff89e583258a7f8e7adeeeaeae8611bf.tar.gz",
            .hash = "libxev-0.0.0-86vtcwIRFADbH4hk-EjROXxlrKIRPQdA41XiTSytYO-F",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "build",
        "src",
    },
}
